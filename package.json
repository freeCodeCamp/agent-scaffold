{
  "name": "@freecodecamp/agent-scaffold",
  "version": "0.1.0",
  "description": "freeCodeCamp Scaffold Tool. Make coding agents less dumb. Save time, money, sanity.",
  "keywords": [
    "agents",
    "cli",
    "freecodecamp",
    "scaffold"
  ],
  "homepage": "https://github.com/freeCodeCamp/agent-scaffold#readme",
  "bugs": {
    "url": "https://github.com/freeCodeCamp/agent-scaffold/issues"
  },
  "license": "BSD-3-Clause",
  "author": "Mrugesh Mohapatra <noreply@mrugesh.dev> (https://mrugesh.dev/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freeCodeCamp/agent-scaffold.git"
  },
  "bin": {
    "agent-scaffold": "dist/index.cjs"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsdown && COPYFILE_DISABLE=1 tar -czf dist/templates.tgz -C templates . && node scripts/check-templates-tgz.mjs",
    "lint": "oxlint src tests",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "prepare": "husky",
    "dev": "tsx src/index.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepublishOnly": "node scripts/check-templates-tgz.mjs"
  },
  "devDependencies": {
    "@clack/prompts": "^1.5.0",
    "@types/node": "^24.12.2",
    "commander": "14.0.3",
    "husky": "^9.1.7",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.68.0",
    "tsdown": "0.22.1",
    "tsx": "4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
