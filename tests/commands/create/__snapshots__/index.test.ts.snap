",
  "Procfile": "web: node dist/index.js
",
  "README.md": "# snapshot-node-app

Generated by agent-scaffold.
",
  "compose.yaml": "services:
  app:
    build:
      context: ./
      target: dev
    develop:
      watch:
        - action: sync
          path: ./src
          target: /app/src
        - action: rebuild
          path: ./package.json
        - action: rebuild
          path: ./pnpm-lock.yaml
    ports:
      - 3000:3000
",
  "package.json": "{
  "name": "snapshot-node-app",
  "private": true,
  "type": "module"
}
",
  "src/index.ts": "console.log('hello');
",
  "src/start.ts": "symlink:index.ts",
}
`;

